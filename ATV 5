CREATE OR REPLACE VIEW vw_desempenho_vendedores AS
SELECT 
    v.nome AS nome_vendedor,
    COUNT(vd.id) AS quantidade_vendas,
    SUM(vd.valor_venda) AS valor_total_vendido,
    AVG(vd.valor_venda) AS valor_medio_vendas,
    MAX(vd.valor_venda) AS maior_venda_realizada
FROM vendedores v
LEFT JOIN vendas vd ON v.id = vd.vendedor_id
GROUP BY v.id, v.nome;

SELECT * FROM vw_desempenho_vendedores;
