CREATE OR REPLACE VIEW vw_pedidos_clientes AS
SELECT 
    c.nome AS nome_cliente,
    p.data_pedido,
    p.valor_pedido
FROM pedidos p
INNER JOIN clientes c ON p.cliente_id = c.id;

